# Copiar este archivo como .env y completar con los datos de tu PostgreSQL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodstore_db
# Para desarrollo local sin PostgreSQL también se acepta:
# DATABASE_URL=sqlite:///./foodstore.db

# Clave de firma del JWT: mínimo 32 caracteres. Generar una propia, por ejemplo con
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS (con credenciales).
FRONTEND_ORIGIN=http://localhost:5173

# true solo cuando la API se sirve por HTTPS.
COOKIE_SECURE=false
